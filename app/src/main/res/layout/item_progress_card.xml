<?xml version="1.0" encoding="utf-8"?>
<!--
  item_progress_card.xml

  Purpose:
    Defines the layout for one "Progress Overview" card in the Profile screen.
    Each card typically shows:
      - A placeholder/cover area (top rectangle, can be replaced with an image or progress bar later)
      - A course or level name underneath (e.g., "Spanish Level 1")

  Design notes:
    • Wrapped in MaterialCardView for modern look with rounded corners.
    • Fixed width (240dp) so multiple cards can scroll horizontally.
    • Uses colorSurfaceVariant as a neutral background placeholder.
    • Text styled bold to emphasize course/progress name.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:layout_marginStart="12dp"
    app:cardCornerRadius="16dp"
    app:strokeColor="@android:color/transparent">

    <!-- Vertical container for placeholder + text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Placeholder block (could hold an image or graphic later) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="?attr/colorSurfaceVariant"
            android:layout_marginBottom="8dp"/>

        <!-- Course/progress name label -->
        <TextView
            android:id="@+id/tvCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spanish Level 1"
            android:textStyle="bold"
            android:textSize="14sp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

