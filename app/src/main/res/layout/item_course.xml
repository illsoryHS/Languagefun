<?xml version="1.0" encoding="utf-8"?>
<!--
  item_course.xml
  Purpose:
    - A compact course card used in the horizontal "Popular Courses" list.
    - Matches the mock: rounded light-grey cover block + bold title + muted subtitle.

  Notes:
    - The ImageView has a light-grey rounded background so it looks good even without a real image.
    - Card elevation kept low for a clean, modern look. Increase app:cardElevation if you want a stronger shadow.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="match_parent"
    android:layout_marginStart="12dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="false"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/transparent"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Cover image placeholder:
             - Shows a rounded, light-grey block by default.
             - If you provide a drawable via adapter, it'll display on top (centerCrop). -->
        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_placeholder_grey_12"
            android:layout_marginBottom="8dp"/>

        <!-- Title (2 lines max) -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spanish for Beginners"
            android:textStyle="bold"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Subtitle (muted color for hierarchy) -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daily Conversations"
            android:textSize="12sp"
            android:textColor="@color/grey_300" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>


