<?xml version="1.0" encoding="utf-8"?>
<!--
  item_achievement.xml

  Purpose:
    Defines the layout for one achievement card in the Profile screen.
    Each card shows:
      - An icon (e.g., star, flag)
      - A title (e.g., "Completed Lessons")
      - An optional subtitle (extra info, can be empty)

  Design notes:
    • Uses MaterialCardView for a modern, elevated look with rounded corners.
    • Background color comes from the theme (colorSurfaceVariant).
    • Card height fixed at 110dp to keep grid uniform.
    • Padding and margin ensure spacing between cards (plus extra spacing via ItemDecoration).
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardUseCompatPadding="false"
    app:strokeColor="@android:color/transparent"
    app:cardBackgroundColor="?attr/colorSurfaceVariant">

    <!-- Container for icon + texts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Achievement icon -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_star"
            android:contentDescription="@null" />

        <!-- Main title (e.g., "Completed Lessons") -->
        <TextView
            android:id="@+id/tvAchTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completed Lessons"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <!-- Optional subtitle (smaller, lighter text) -->
        <TextView
            android:id="@+id/tvAchSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

